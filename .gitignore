# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
# Symbol-cache and rescue libraries can be required design sources; keep them.
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Temporary netlist/BOM XML exports in the project directory.
# Keep bom/*.csv: these are intentional, reviewable purchasing/assembly BOMs.
/*.xml

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local git-based history (KiCad 9.0+)
.history

# Local project settings
*.kicad_prl

# Production Files and Plots
/build/
/dist/
/production/
/plots/
/gerbers/
/fabrication/
/jlcpcb/production_files/
*.gbr
*.gbrjob
*.drl
fabrication-toolkit-options.json

# Python tools: local environments and generated caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Tool logs
*.log

# Keep project-local symbol/footprint libraries, library tables, inventory
# snapshots, documentation, and the explicitly maintained schematic PDF.

# macOS
.DS_Store
._*
